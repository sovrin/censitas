{
  "censitas": 1,
  "sites": [
    {
      "id": "sonotas",
      "origins": ["https://sonotas.sovrin.de", "http://localhost:3000"],
      "events": {
        "pageview": {},
        "file-open": {
          "format": ["gp", "gpx", "gp3", "gp4", "gp5", "musicxml", "mxl"]
        },
        "file-error": {
          "format": ["gp", "gpx", "gp3", "gp4", "gp5", "musicxml", "mxl", "other"]
        },
        "track-switch": {},
        "export-start": {
          "aspect": ["16:9", "9:16", "1:1"],
          "resolution": ["1080p", "720p", "480p"],
          "fps": ["24", "30", "60"],
          "quality": ["standard", "high", "max"],
          "fast": ["on", "off"],
          "layout": ["line", "page"],
          "view": ["bar", "screen", "track"],
          "staves": ["tab", "standard-tab", "standard"],
          "theme": ["dark", "light"],
          "length": ["0-1min", "1-3min", "3-5min", "5-10min", "10min+"]
        },
        "export-sound": {
          "mix": ["all", "solo", "minus"],
          "metronome": ["on", "off"],
          "countIn": ["on", "off"]
        },
        "export-done": {
          "resolution": ["1080p", "720p", "480p"],
          "fast": ["on", "off"],
          "took": ["0-30s", "30s-2min", "2-10min", "10min+"]
        },
        "export-fail": {
          "resolution": ["1080p", "720p", "480p"],
          "fast": ["on", "off"]
        },
        "export-cancel": {},
        "video-download": {},
        "link-copy": {}
      }
    }
  ]
}

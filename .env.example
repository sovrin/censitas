# The dashboard's sign-in (HTTP basic auth). Generate the password once: openssl rand -hex 24
CENSITAS_USER=owner
CENSITAS_PASSWORD=

# The sites file on the host: which sites may send, from which origins, which events and props.
# Copy sites.example.json to start. Read at start; restart after a change.
# CENSITAS_SITES_FILE=./sites.json

# Where the web service listens on the host (loopback by default; your proxy reaches it there or
# over a network added in compose.override.yaml).
# CENSITAS_BIND=127.0.0.1:3100
